# Copie este arquivo para .env e preencha. O .env não vai para o GitHub.

# Domínio (somente para docker-compose com Caddy) e endereço público do sistema (links dos e-mails)
DOMINIO=despesas.suaempresa.com.br
APP_URL=https://despesas.suaempresa.com.br
PORT=3000

# Leitura automática dos comprovantes (Claude / Anthropic)
ANTHROPIC_API_KEY=

# Avisos por e-mail (SMTP)
# Exemplos: Gmail/Google Workspace -> smtp.gmail.com, porta 587, usuário = e-mail, senha = "senha de app"
#           Microsoft 365          -> smtp.office365.com, porta 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Despesas <despesas@suaempresa.com.br>"

# Primeiro acesso: administrador master criado na primeira execução
MASTER_EMAIL=admin@suaempresa.com.br
MASTER_PASSWORD=

# Backup automático diário (padrão: às 2h, guarda os 14 últimos em DATA_DIR/backups)
BACKUP_HOUR=2
BACKUP_KEEP=14
# BACKUP_DIR=/caminho/de/outro/disco
