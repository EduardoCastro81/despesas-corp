# Copie este arquivo para .env e preencha. O .env não vai para o GitHub.

# Endereço público do sistema (usado nos links dos e-mails)
APP_URL=https://despesas.suaempresa.com.br
PORT=3000

# Leitura automática dos comprovantes (Claude / Anthropic)
ANTHROPIC_API_KEY=

# Avisos por e-mail (SMTP)
# Exemplos: Gmail/Google Workspace -> smtp.gmail.com, porta 587, usuário = e-mail, senha = "senha de app"
#           Microsoft 365          -> smtp.office365.com, porta 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Despesas <despesas@suaempresa.com.br>"
